// ==============================================================================
// 프로젝트: HM01B0 카메라 실시간 프리뷰 (최적화 버전)
// ==============================================================================

#include "LCD_st7735.h"      // ST7735 디스플레이 제어 라이브러리
#include "arducam_hm01b0.h"  // HM01B0 카메라 제어 (I2C + PIO) 라이브러리

#define LED_PIN 25           // 상태 표시용 LED 핀 (Pico 보드 내장 LED)

// ------------------------------------------------------------------------------
// 1. 색상 포맷 변환 매크로 (8-bit 흑백 -> 16-bit RGB565)
// ------------------------------------------------------------------------------
// 8비트 흑백 값을 R(5비트), G(6비트), B(5비트) 채널에 맞게 비트 시프트 연산하여
// 16비트 컬러 픽셀 데이터로 변환해 주는 고속 매크로 함수입니다.
#define ST7735_COLOR565(r, g, b) (((r & 0xF8) << 8) | ((g & 0xFC) << 3) | ((b & 0xF8) >> 3))

// ------------------------------------------------------------------------------
// 2. 카메라 데이터 전역 변수
// ------------------------------------------------------------------------------
uint8_t image_data[96 * 96];      // 카메라에서 받아올 흑백 원본 데이터 (9,216 bytes)
uint8_t displayBuf[96 * 96 * 2];  // LCD로 보낼 16비트 컬러 데이터 (18,432 bytes)

struct arducam_config config;     // 카메라의 초기화 설정값을 담을 구조체

void setup() {
  // ----------------------------------------------------------------------------
  // [Step 1] LCD 초기화 및 시작 화면 출력
  // ----------------------------------------------------------------------------
  ST7735_Init();
  // 부팅 시 Arducam 로고를 화면 전체(80x160)에 출력합니다.
  ST7735_DrawImage(0, 0, 80, 160, arducam_logo);
  sleep_ms(1000); // 1초 대기

  // ----------------------------------------------------------------------------
  // [Step 2] HM01B0 카메라 하드웨어 및 통신 핀 세팅
  // ----------------------------------------------------------------------------
  config.sccb = i2c0;                  // 제어 명령을 보낼 I2C 통신 채널
  config.sccb_mode = I2C_MODE_16_8;    // 레지스터 주소 16비트, 데이터 8비트 규격
  config.sensor_address = 0x24;        // HM01B0 고유 I2C 주소
  
  config.pin_sioc = PIN_CAM_SIOC;      // I2C 클럭 핀 (SCL)
  config.pin_siod = PIN_CAM_SIOD;      // I2C 데이터 핀 (SDA)
  config.pin_resetb = PIN_CAM_RESETB;  // 센서 하드웨어 리셋 핀
  config.pin_xclk = PIN_CAM_XCLK;      // 센서를 구동할 마스터 클럭 핀
  config.pin_vsync = PIN_CAM_VSYNC;    // 새 프레임 시작을 알리는 동기화 핀
  config.pin_y2_pio_base = PIN_CAM_Y2_PIO_BASE; // 데이터가 들어오는 베이스 핀
  
  config.pio = pio0;                   // 고속 캡처를 담당할 PIO 하드웨어 모듈
  config.pio_sm = 0;                   // 상태 머신 번호
  config.dma_channel = 0;              // CPU 간섭 없이 데이터를 메모리로 옮길 DMA 채널
  
  // 세팅된 구조체 값을 바탕으로 카메라를 최종 초기화합니다.
  arducam_init(&config);

  // 로고를 지우고 화면을 검은색으로 리셋하여 카메라 프리뷰 준비를 마칩니다.
  ST7735_FillScreen(ST7735_BLACK);
}

void loop() {
  // ----------------------------------------------------------------------------
  // [Step 3] 영상 캡처 (PIO & DMA 작동)
  // ----------------------------------------------------------------------------
  // PIO가 VSYNC/HREF 신호에 맞춰 픽셀을 읽고 DMA를 통해 image_data 버퍼에 채웁니다.
  // (불필요한 타입 캐스팅을 제거하여 코드를 간결하게 정리했습니다.)
  arducam_capture_frame(&config, image_data); 
  
  register uint16_t index = 0;
  
  // ----------------------------------------------------------------------------
  // [Step 4] 데이터 포맷 변환 (8-bit -> 16-bit)
  // ----------------------------------------------------------------------------
  for (int x = 0; x < 96 * 96; x++) {
    // image_data[x]를 한 번만 읽어서 지역 변수에 저장한 뒤 연산에 재사용합니다.
    uint8_t pixel = image_data[x]; 
    
    // R, G, B 채널에 동일한 밝기 값을 넣어 회색조 16비트 픽셀을 생성합니다.
    uint16_t imageRGB = ST7735_COLOR565(pixel, pixel, pixel);
    
    // 생성된 16비트(2바이트) 데이터를 상위 바이트와 하위 바이트로 쪼개어
    // 디스플레이 전송용 8비트 배열 버퍼에 순서대로 담아줍니다.
    displayBuf[index++] = (imageRGB >> 8) & 0xFF; // 상위 8비트
    displayBuf[index++] = imageRGB & 0xFF;        // 하위 8비트
  }
  
  // ----------------------------------------------------------------------------
  // [Step 5] 화면 고속 렌더링
  // ----------------------------------------------------------------------------
  // 처리가 끝난 전역 버퍼 데이터를 SPI 고속도로를 통해 LCD에 연속(Burst)으로 전송합니다.
  ST7735_DrawImage(0, 0, 96, 96, displayBuf);
}
