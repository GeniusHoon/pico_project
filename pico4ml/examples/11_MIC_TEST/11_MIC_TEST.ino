// ==============================================================================
// 프로젝트: I2S 마이크 실시간 파형 출력
// 설  명: I2S 공인 라이브러리의 read16() 함수를 사용하여 스테레오 데이터를 읽고,
//         시리얼 플로터에 소리의 파도(Waveform)를 실시간 그래프로 그립니다.
// ==============================================================================

#include <I2S.h>

// Pico4ML I2S 하드웨어 핀 설정
#define pBCLK 27  // SCK (비트 클럭)
#define pDOUT 26  // SDATA (데이터 수신)
// ※ LRCLK(WS) 핀은 pBCLK + 1인 28번으로 라이브러리가 자동 할당합니다.

// I2S 입력 객체 생성 (기본 생성자 사용 후 setup에서 세팅)
I2S i2s(INPUT);

void setup() {
  Serial.begin(115200);
  
  // ----------------------------------------------------------------------------
  // I2S 수신기 설정
  // ----------------------------------------------------------------------------
  i2s.setDATA(pDOUT);
  i2s.setBCLK(pBCLK); // LRCLK = BCLK + 1 자동 적용
  
  i2s.setBitsPerSample(16); // 16비트 오디오 해상도
  //i2s.setFrequency(16000);  // 16kHz 샘플링 레이트 (음성 인식에 가장 많이 쓰이는 주파수)
  i2s.setFrequency(44100);  // 44.1kHz 샘플링 레이트 (음성 인식에 가장 많이 쓰이는 주파수)

  // I2S 통신 시작 (PIO 상태 머신 가동)
  if (!i2s.begin()) {
    Serial.println("I2S 초기화 실패! 핀 연결을 확인하세요.");
    while (1); // 에러 발생 시 프로그램 정지
  }
}

void loop() {
  int16_t l, r; // 왼쪽 채널과 오른쪽 채널 데이터를 담을 변수

  // ----------------------------------------------------------------------------
  // 데이터 수신 (Blocking 방식)
  // ----------------------------------------------------------------------------
  // I2S 통신망에서 데이터 1세트(왼쪽+오른쪽)가 들어올 때까지 기다렸다가 읽어옵니다.
  i2s.read16(&l, &r);

  // ----------------------------------------------------------------------------
  // 데이터 출력 (시리얼 플로터 양식에 맞춤)
  // ----------------------------------------------------------------------------
  // 두 값을 띄어쓰기로 구분하여 출력하면 플로터가 2개의 선(다중 그래프)을 그립니다.
  Serial.printf("%d %d\r\n", l, r);
}
