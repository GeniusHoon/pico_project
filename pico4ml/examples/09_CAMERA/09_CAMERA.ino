// ==============================================================================
// 프로젝트: HM01B0 카메라 실시간 프리뷰
// 설  명: PIO와 DMA를 이용하여 카메라의 흑백 영상을 캡처하고, 
//         이를 16비트 컬러 포맷으로 변환하여 LCD에 실시간으로 출력합니다.
// ==============================================================================

#include <Arduino_GFX_Library.h> // 디스플레이 제어를 위한 하드웨어 추상화 라이브러리
#include <SPI.h>                 // 디스플레이와 고속 통신을 하기 위한 SPI 라이브러리
#include "arducam_hm01b0.h"      // 카메라 제어(I2C) 및 데이터 캡처(PIO/DMA) 통합 라이브러리

// ------------------------------------------------------------------------------
// 1. LCD 하드웨어 핀 설정 (Pico4ML 보드 기준)
// ------------------------------------------------------------------------------
#define TFT_CS     13  // Chip Select: LCD 칩을 활성화하는 핀
#define TFT_RST    7   // Reset: LCD 하드웨어 리셋 핀
#define TFT_DC     9   // Data/Command: 전송하는 값이 데이터인지 명령어인지 구분하는 핀
#define TFT_MISO   12  // Master In Slave Out (LCD -> MCU) - 여기서는 사용하지 않음
#define TFT_MOSI   11  // Master Out Slave In (MCU -> LCD) - 픽셀 데이터를 보내는 핀
#define TFT_SCK    10  // Serial Clock: 통신 박자를 맞춰주는 클럭 핀

// ------------------------------------------------------------------------------
// 2. 색상 포맷 변환 매크로 (8-bit 흑백 -> 16-bit RGB565)
// ------------------------------------------------------------------------------
// 카메라는 0~255의 밝기 값(8비트)을 줍니다. 하지만 LCD는 R(5비트), G(6비트), B(5비트)를 합친
// 16비트 데이터를 원합니다. 흑백은 R, G, B의 비율이 같으므로 동일한 값을 비트 이동연산(Shift)을 
// 통해 각 채널에 쑤셔 넣어 무채색(회색조)을 만들어내는 수식입니다.
#define ST7735_COLOR565(r, g, b) (((r & 0xF8) << 8) | ((g & 0xFC) << 3) | ((b & 0xF8) >> 3))

// ------------------------------------------------------------------------------
// 3. 전역 객체 및 버퍼 할당 (메모리 단편화 방지)
// ------------------------------------------------------------------------------
// LCD 통신 버스 및 디스플레이 객체 생성 (화면 회전값: 2)
Arduino_DataBus *bus = new Arduino_HWSPI(TFT_DC, TFT_CS, &SPI1, true);
Arduino_GFX *gfx = new Arduino_ST7735( bus, TFT_RST, 2, false, 80, 160, 24, 0, 24, 0);

// 카메라 데이터 전역 변수
uint8_t image_data[96 * 96];  // 카메라가 찍은 원본 흑백 데이터용 방 (9,216 바이트)
uint16_t displayBuf[96 * 96]; // LCD에 뿌려줄 컬러 포맷 데이터용 방 (18,432 바이트)

struct arducam_config config; // 카메라 설정값들을 저장할 구조체

void setup() {
  Serial.begin(115200); // 디버깅용 시리얼 통신 시작

  // ----------------------------------------------------------------------------
  // [Step 1] LCD 초기화
  // ----------------------------------------------------------------------------
  SPI1.setSCK(TFT_SCK); // RP2040의 SPI1 포트 핀들을 우리가 정의한 핀으로 맵핑
  SPI1.setTX(TFT_MOSI);
  SPI1.setRX(TFT_MISO);
  SPI1.setCS(TFT_CS);
  
  gfx->begin();               // 디스플레이 칩 깨우기
  gfx->fillScreen(RGB565_WHITE);     // 화면 전체를 하얀색으로 칠해서 초기화

  // ----------------------------------------------------------------------------
  // [Step 2] 카메라 초기화 (I2C 설정 + PIO/DMA 세팅)
  // ----------------------------------------------------------------------------
  config.sccb = i2c0;                  // 설정 명령을 보낼 I2C 통신 포트
  config.sccb_mode = I2C_MODE_16_8;    // 레지스터 주소는 16비트, 데이터는 8비트
  config.sensor_address = 0x24;        // HM01B0 카메라의 고유 I2C 주소 (데이터시트 확인 완료)
  
  config.pin_sioc = PIN_CAM_SIOC;      // I2C 클럭 핀 (SCL)
  config.pin_siod = PIN_CAM_SIOD;      // I2C 데이터 핀 (SDA)
  config.pin_resetb = PIN_CAM_RESETB;  // 하드웨어 리셋 핀
  config.pin_xclk = PIN_CAM_XCLK;      // 카메라 심장을 뛰게 할 마스터 클럭 핀
  config.pin_vsync = PIN_CAM_VSYNC;    // 새 프레임 시작을 알리는 동기화 핀
  config.pin_y2_pio_base = PIN_CAM_Y2_PIO_BASE; // 픽셀 데이터를 받아올 베이스 핀 (D0)
  
  config.pio = pio0;                   // 데이터를 고속으로 캡처할 하청업체(PIO 0번) 지정
  config.pio_sm = 0;                   // PIO 내부의 상태 머신 번호
  config.dma_channel = 0;              // CPU 대신 메모리로 데이터를 쏴줄 DMA 고속도로 채널
  
  // 위 설정값과 마법의 초기화 배열을 이용해 카메라를 최종적으로 세팅합니다.
  arducam_init(&config);
}

void loop() {
  // ----------------------------------------------------------------------------
  // [Step 3] 영상 캡처 (PIO & DMA 작동)
  // ----------------------------------------------------------------------------
  // 메인 CPU는 가만히 있고, PIO와 DMA가 카메라 핀의 신호를 읽어 image_data 버퍼를 꽉 채워줍니다.
  arducam_capture_frame(&config, image_data);

  // ----------------------------------------------------------------------------
  // [Step 4] 데이터 포맷 변환 (8-bit -> 16-bit)
  // ----------------------------------------------------------------------------
  for (int i = 0; i < 96 * 96; i++) {
    // 흑백 데이터 1개를 읽어와 R, G, B 채널에 동일하게 복사하여 무채색 픽셀을 완성합니다.
    displayBuf[i] = ST7735_COLOR565(image_data[i], image_data[i], image_data[i]);
  }
  
  // ----------------------------------------------------------------------------
  // [Step 5] 화면 고속 출력
  // ----------------------------------------------------------------------------
  // 픽셀을 하나씩 찍으면 느리므로, 변환이 끝난 96x96(9,216개) 픽셀 버퍼를 한 방에 LCD로 쏟아냅니다.
  gfx->draw16bitRGBBitmap(0, 0, displayBuf, 96, 96);
}
